# Configuration du serveur
PORT=4000
NODE_ENV=production

# URL du frontend pour CORS
FRONTEND_URL=https://longrich.online

# Sécurité
SESSION_SECRET=changez_ceci_par_une_chaine_aleatoire_securisee

# SMS Configuration - Contrôle l'activation/désactivation de la vérification SMS
# true = vérification SMS activée, false = vérification SMS désactivée
SEND_TWILIO_CODE=false

# Configuration Twilio (requis seulement si SEND_TWILIO_CODE=true)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Timeout pour le script de paiement (en millisecondes)
PAYMENT_SCRIPT_TIMEOUT=30000

# Configuration SenePay (Mobile Money)
SENEPAY_API_KEY=your_api_key_here
SENEPAY_API_SECRET=your_api_secret_here
SENEPAY_WEBHOOK_SECRET=your_webhook_secret_here


# URL de base pour les callbacks IPN
IPN_BASE_URL=https://api.longrich.online 

#la configuration firebase admin est requis 