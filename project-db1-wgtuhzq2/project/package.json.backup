{
  "name": "modern-ecommerce-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/post-build.js && node scripts/generate-seo.cjs",
    "build:prod": "vite build --mode production && node scripts/post-build.js && node scripts/generate-seo.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:rules": "cd tests && npx jest security --runInBand"
  },
  "dependencies": {
    "@firebase/app-check": "^0.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.3.1",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "firebase": "^12.6.0",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.469.0",
    "morgan": "^1.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "twilio": "^5.7.2",
    "uuid": "^11.1.0",
    "validator": "^13.15.23"
  },
  "devDependencies": {
    "@babel/types": "^7.28.0",
    "@firebase/rules-unit-testing": "^3.0.1",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.20.7",
    "@types/dompurify": "^3.2.0",
    "@types/history": "^4.7.11",
    "@types/jest": "^29.5.12",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/react-router-dom": "^5.3.3",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "firebase-admin": "^10.3.0",
    "history": "^5.3.0",
    "javascript-obfuscator": "^4.1.1",
    "jest": "^29.7.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
