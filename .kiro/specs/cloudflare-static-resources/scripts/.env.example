# Configuration pour les scripts Cloudflare
# Copiez ce fichier vers .env et remplissez les valeurs

# Authentification Cloudflare (utilisez soit API_KEY + EMAIL, soit API_TOKEN)
CLOUDFLARE_API_KEY=your_api_key_here
CLOUDFLARE_EMAIL=your_email_here
# OU
CLOUDFLARE_API_TOKEN=your_api_token_here

# ID de zone Cloudflare pour votre domaine
CLOUDFLARE_ZONE_ID=your_zone_id_here

# Domaine à configurer
DOMAIN=longrich.online